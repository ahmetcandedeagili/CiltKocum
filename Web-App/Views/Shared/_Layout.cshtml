<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CiltKoçum</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .hover-dark:hover {
            color: #000 !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">✨ CiltKoçum</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Analiz</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="text-light me-3 small">Hoş geldin, @User.Identity.Name</span>
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-light btn-sm me-2">Profilim</a>
                            <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger btn-sm">Çıkış Yap</a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-sm me-2">Giriş Yap</a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-light btn-sm">Kayıt Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top text-muted mt-5 py-4 bg-white" style="border-radius: 0;">
        <div class="container">
            <div class="row align-items-center text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px; font-weight: 600;">
                <div class="col-md-4 text-center text-md-start text-dark">
                    &copy; @DateTime.Now.Year — CİLT KOÇUM LABS. ALL RIGHTS RESERVED.
                    <br /><span class="text-danger text-capitalize" style="font-size:0.6rem;">* Tıbbi tavsiye değildir. Lütfen dermatoloğa danışın.</span>
                </div>
                <div class="col-md-8 text-center text-md-end mt-2 mt-md-0">
                    <a href="#" class="text-decoration-none text-secondary mx-3 hover-dark">Gizlilik Politikası</a>
                    <a href="#" class="text-decoration-none text-secondary mx-3 hover-dark">KVKK Aydınlatma Metni</a>
                    <a href="https://github.com/ahmetcandedeagili/CiltKocum" target="_blank" class="text-decoration-none text-dark fw-bold mx-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-github me-1" viewBox="0 0 16 16">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
                        </svg> Kaynak Kodları
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>